# Copy to .env.functions in the Supabase stack directory and edit the origins.
ALLOWED_ORIGINS=https://platform.example.com,https://www.example.com,https://admin.example.com

# Set a fresh random value before enabling the landing contact form.
# CONTACT_IP_SALT=

# Optional contact form notifications. Submissions are saved without these.
# CONTACT_TO_EMAIL=you@example.com
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL="EchoBox Logistics <hello@example.com>"

# configure-rider-push.py adds PUSH_WORKER_TOKEN and FCM_SERVICE_ACCOUNT_JSON.
