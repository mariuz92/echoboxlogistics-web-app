{
  "name": "echoboxlogistics-web-app",
  "version": "2.0.0",
  "description": "EchoBox Logistics web app: order, rider and radio-channel management for audio-guide rental operations.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:landing": "vite --mode landing",
    "build:landing": "tsc --noEmit && vite build --mode landing",
    "preview:landing": "vite preview --mode landing",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "audit:prod": "npm audit --omit=dev",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "docker:build": "docker build -t echoboxlogistics-web-app .",
    "docker:smoke": "bash scripts/docker-smoke-test.sh echoboxlogistics-web-app:latest"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-google-maps/api": "^2.20.8",
    "@refinedev/core": "^5.0.12",
    "@refinedev/react-router": "^2.0.4",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.108.0",
    "antd": "^6.7.1",
    "dayjs": "^1.11.23",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
