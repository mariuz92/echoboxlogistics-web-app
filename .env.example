# Copy to .env.local and fill in. Never commit real values.
#
# For the LOCAL Supabase stack (npm run db:start) the values are printed by
# `supabase status`; this repo uses API port 55321 so it can run alongside
# other Supabase projects.

# --- Supabase (required) ----------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=

# --- Optional ---------------------------------------------------------------
# Google Places autocomplete for delivery / pickup addresses.
VITE_GOOGLE_MAPS_API_KEY=

# Tenant slug served by the legacy /OrdineGuida public booking URL.
VITE_PUBLIC_BOOKING_SLUG=

# Show the "Continue with Google" button (the Google provider must also be
# enabled in Supabase Auth).
VITE_ENABLE_GOOGLE_AUTH=false

# Optional: where the "back to the site" link of the public booking page points.
VITE_MARKETING_URL=
